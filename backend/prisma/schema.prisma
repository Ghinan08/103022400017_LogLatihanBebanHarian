generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Latihan {
  id        Int      @id @default(autoincrement())
  nama      String
  target    String
  set       Int
  createdAt DateTime @default(now())

  @@map("latihan")
}